NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/olinethra

JWT_ACCESS_SECRET=your-32-character-random-access-secret
JWT_REFRESH_SECRET=your-32-character-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Olinethra <noreply@olinethra.com>
ADMIN_EMAIL=hello@olinethra.com
SEED_ADMIN_NAME=Olinethra Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=30
