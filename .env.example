# ==========================================
# OLINETHRA — PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# ------------------------------------------
# APPLICATION & PUBLIC METADATA
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ID=

# ------------------------------------------
# AUTHENTICATION (SERVER-ONLY)
# ------------------------------------------
AUTH_SECRET=your-32-character-random-secret-key

# ------------------------------------------
# DATABASE (SERVER-ONLY)
# ------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/olinethra?retryWrites=true&w=majority

# ------------------------------------------
# CLOUDINARY MEDIA (SERVER & PUBLIC)
# ------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------
# AI CHATBOT & ASSISTANT (SERVER-ONLY)
# ------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ------------------------------------------
# TRANSACTIONAL EMAIL & NOTIFICATIONS (SERVER-ONLY)
# ------------------------------------------
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Olinethra <noreply@olinethra.com>
ADMIN_EMAIL=hello@olinethra.com

# SMTP Alternative (Optional)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@olinethra.com
SMTP_PASSWORD=your-smtp-password
