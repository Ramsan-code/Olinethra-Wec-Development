# ==========================================
# OLINETHRA — PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# ------------------------------------------
# APPLICATION & PUBLIC METADATA
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=+15550192834
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Google OAuth (server-only; never prefix the secret with NEXT_PUBLIC_)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/auth/google/callback

# Backend-only credentials belong in olinethra-api/.env; see
# olinethra-api/.env.example. Never expose them with NEXT_PUBLIC_ prefixes.

